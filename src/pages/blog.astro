---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const categories = [...new Set(posts.map(post => post.data.category))];
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog | KhidirID">
  <!-- Hero Section -->
  <div class="relative overflow-hidden bg-gradient-to-br from-amber-500 to-red-600 text-white">
    <div class="absolute inset-0 bg-grid-white/[0.1] bg-[size:60px_60px]"></div>
    <div class="container mx-auto px-4 py-24 relative z-10">
      <h1 
        class="text-5xl md:text-7xl font-bold mb-6 font-display animate-fade-in"
        style="--animation-delay: 200ms"
      >
        Security Blog
      </h1>
      <p 
        class="text-xl md:text-2xl text-amber-100 max-w-2xl animate-fade-in"
        style="--animation-delay: 400ms"
      >
        Deep dives into cybersecurity, CTF writeups, and cloud security insights.
      </p>
    </div>
    <div class="absolute bottom-0 inset-x-0 h-40 bg-gradient-to-t from-gray-50 dark:from-gray-900 to-transparent"></div>
  </div>

  <main class="container mx-auto px-4 py-12">
    <!-- Category Filter -->
    <div class="flex gap-4 mb-12 overflow-x-auto pb-2 animate-fade-in" style="--animation-delay: 600ms">
      <button
        class="category-btn px-6 py-3 rounded-full border-2 border-gray-200 dark:border-gray-700 hover:border-amber-500 hover:bg-amber-50 dark:hover:bg-amber-900/20 transition-all font-medium"
        data-category="all"
      >
        All Posts
      </button>
      {categories.map(category => (
        <button
          class="category-btn px-6 py-3 rounded-full border-2 border-gray-200 dark:border-gray-700 hover:border-amber-500 hover:bg-amber-50 dark:hover:bg-amber-900/20 transition-all font-medium whitespace-nowrap"
          data-category={category}
        >
          {category}
        </button>
      ))}
    </div>

    <!-- Blog Posts Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedPosts.map((post, index) => (
        <article 
          class="blog-post group bg-white dark:bg-gray-800 rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 animate-fade-in"
          data-category={post.data.category}
          style={`--animation-delay: ${800 + index * 100}ms`}
        >
          <a href={`/blog/${post.slug}`} class="block p-6">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-sm px-3 py-1 bg-amber-100 dark:bg-amber-900/30 text-amber-800 dark:text-amber-200 rounded-full font-medium">
                {post.data.category}
              </span>
              <time class="text-sm text-gray-500" datetime={post.data.date.toISOString()}>
                {new Date(post.data.date).toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric'
                })}
              </time>
            </div>
            <h2 class="text-xl font-bold mb-3 group-hover:text-amber-500 transition-colors">
              {post.data.title}
            </h2>
            <p class="text-gray-600 dark:text-gray-400 line-clamp-3">
              {post.data.description}
            </p>
          </a>
        </article>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }
</style>

<script>
  const categoryBtns = document.querySelectorAll('.category-btn');
  const posts = document.querySelectorAll('.blog-post');

  categoryBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const category = btn.getAttribute('data-category');
      
      categoryBtns.forEach(b => b.classList.remove('border-blue-500'));
      btn.classList.add('border-blue-500');

      posts.forEach(post => {
        if (category === 'all' || post.getAttribute('data-category') === category) {
          post.style.display = 'block';
        } else {
          post.style.display = 'none';
        }
      });
    });
  });
</script>
