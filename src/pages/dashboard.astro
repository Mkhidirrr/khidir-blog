---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTFStats from '../components/CTFStats.astro';
import AdvancedSearch from '../components/AdvancedSearch.astro';
import RecentActivity from '../components/RecentActivity.astro';
import ProgressGraph from '../components/ProgressGraph.astro';
---

<BaseLayout title="Dashboard">
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-8">CTF Progress Dashboard</h1>
    
    <CTFStats />
    
    <div class="grid md:grid-cols-2 gap-6 mt-12">
      <ProgressGraph />
      <RecentActivity />
    </div>
    
    <div class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">Find Writeups</h2>
      <AdvancedSearch />
    </div>
  </main>
</BaseLayout>
