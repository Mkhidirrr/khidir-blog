---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const ctfs = await getCollection('ctf');
const featuredPosts = await getCollection('blog', ({ data }) => data.featured);

const stats = {
  totalCTFs: ctfs.length,
  solvedCTFs: ctfs.filter(ctf => ctf.data.solved).length,
  platforms: [...new Set(ctfs.map(ctf => ctf.data.platform))].length,
  writeups: ctfs.filter(ctf => ctf.data.solved).length
};
---

<BaseLayout>
  <!-- Hero Section with Particles -->
  <div class="relative min-h-[80vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-blue-600 to-purple-600">
    <div id="particles-js" class="absolute inset-0 opacity-30"></div>
    <div class="relative z-10 text-center text-white px-4">
      <h1 class="text-5xl md:text-7xl font-bold mb-6 animate-fade-in">
        Security Through
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-yellow-400 to-pink-500">
          Knowledge Sharing
        </span>
      </h1>
      <p class="text-xl md:text-2xl text-blue-100 mb-8 max-w-2xl mx-auto">
        Exploring cybersecurity through CTF writeups, cloud security labs, and practical guides
      </p>
      <div class="flex gap-4 justify-center">
        <a href="/ctf" class="px-6 py-3 bg-white text-blue-600 rounded-lg font-medium hover:bg-blue-50 transition-colors">
          View Writeups
        </a>
        <a href="/blog" class="px-6 py-3 bg-blue-500 text-white rounded-lg font-medium hover:bg-blue-400 transition-colors">
          Read Blog
        </a>
      </div>
    </div>
  </div>

  <!-- Stats Section -->
  <div class="py-16 bg-gray-50 dark:bg-gray-900">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {Object.entries(stats).map(([key, value]) => (
          <div class="text-center">
            <div class="text-4xl font-bold text-blue-600 mb-2">{value}</div>
            <div class="text-gray-600 dark:text-gray-400 capitalize">{key.replace(/([A-Z])/g, ' $1').trim()}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Featured Content -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold mb-8">Featured Content</h2>
      <div class="grid md:grid-cols-3 gap-8">
        {featuredPosts.map(post => (
          <a href={`/blog/${post.slug}`} class="group">
            <article class="h-full bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-lg transition-transform group-hover:-translate-y-1">
              {post.data.coverImage && (
                <img 
                  src={post.data.coverImage} 
                  alt={post.data.title}
                  class="w-full h-48 object-cover"
                />
              )}
              <div class="p-6">
                <h3 class="font-bold text-xl mb-2 group-hover:text-blue-500">{post.data.title}</h3>
                <p class="text-gray-600 dark:text-gray-400">{post.data.description}</p>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
