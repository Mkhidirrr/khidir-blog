---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const platforms = ['htb', 'thm', 'picoctf', 'overthewire', 'rootme'];
  return platforms.map(platform => ({ params: { platform } }));
}

const { platform } = Astro.params;
const allCTFs = await getCollection('ctf');
const platformCTFs = allCTFs.filter(
  ctf => ctf.data.platform.toLowerCase() === platform
);

const platformNames = {
  htb: 'HackTheBox',
  thm: 'TryHackMe',
  picoctf: 'PicoCTF',
  overthewire: 'OverTheWire',
  rootme: 'Root-Me'
};
---

<BaseLayout title={`${platformNames[platform]} Writeups`}>
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-8">{platformNames[platform]} Writeups</h1>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {platformCTFs.map(ctf => (
        <article class="border rounded-lg p-6 hover:shadow-lg transition-all">
          <h2 class="text-xl font-semibold mb-2">{ctf.data.title}</h2>
          <p class="text-gray-600 dark:text-gray-400 mb-4">{ctf.data.description}</p>
          <div class="flex justify-between items-center">
            <span class="text-sm bg-blue-100 dark:bg-blue-900 px-2 py-1 rounded">
              {ctf.data.difficulty}
            </span>
            <a href={`/ctf/${platform}/${ctf.slug}`} class="text-blue-500 hover:underline">
              Read more →
            </a>
          </div>
        </article>
      ))}
    </div>
  </main>
</BaseLayout>
