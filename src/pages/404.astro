---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Page Not Found">
  <div class="flex items-center justify-center min-h-[60vh]">
    <div class="text-center">
      <h1 class="text-6xl font-bold text-gray-900 dark:text-gray-100">404</h1>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">Page not found</p>
      <a href="/" class="mt-8 inline-block px-6 py-3 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors">
        Return Home
      </a>
    </div>
  </div>
</BaseLayout>
