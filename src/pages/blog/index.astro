---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog | KhidirID">
  <main class="container mx-auto px-4 py-12 sm:py-24">
    <h1 class="text-4xl sm:text-5xl md:text-7xl font-bold mb-4 sm:mb-6">Blog Posts</h1>
    <p class="text-lg sm:text-xl md:text-2xl text-amber-100 max-w-2xl">
      Welcome to my blog! Here you'll find my latest thoughts and updates on
      various topics. Feel free to explore and connect with me through the
      comments.
    </p>
    </div>

    <!-- Category Filter -->
    <div class="flex gap-3 mb-6 sm:mb-8 overflow-x-auto pb-2 px-4 sm:px-0">
      <a
        href="/blog"
        class="whitespace-nowrap rounded-full py-2 px-4 text-sm font-semibold bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-200 hover:bg-gray-300 dark:hover:bg-gray-600 transition-all"
        >All Posts</a
      >
      <a
        href="/blog/category/tech"
        class="whitespace-nowrap rounded-full py-2 px-4 text-sm font-semibold bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-200 hover:bg-gray-300 dark:hover:bg-gray-600 transition-all"
        >Tech</a
      >
      <a
        href="/blog/category/lifestyle"
        class="whitespace-nowrap rounded-full py-2 px-4 text-sm font-semibold bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-200 hover:bg-gray-300 dark:hover:bg-gray-600 transition-all"
        >Lifestyle</a
      >
      <a
        href="/blog/category/travel"
        class="whitespace-nowrap rounded-full py-2 px-4 text-sm font-semibold bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-200 hover:bg-gray-300 dark:hover:bg-gray-600 transition-all"
        >Travel</a
      >
    </div>

    <!-- Blog Posts Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 md:gap-8 px-4 sm:px-6">
      {sortedPosts.map(post => (
        <article class="bg-white dark:bg-gray-800 rounded-lg shadow hover:shadow-lg transition-shadow">
          <a href={`/blog/${post.slug}`} class="block p-6">
            <h2 class="text-xl font-bold mb-2">{post.data.title}</h2>
            <p class="text-gray-600 dark:text-gray-400 mb-4">{post.data.description}</p>
            <div class="flex justify-between text-sm text-gray-500">
              <span>{post.data.category}</span>
              <time>{new Date(post.data.date).toLocaleDateString()}</time>
            </div>
          </a>
        </article>
      ))}
    </div>
  </main>
</BaseLayout>
