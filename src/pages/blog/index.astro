---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const categories = [...new Set(posts.map(post => post.data.category))];
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Pagination
const postsPerPage = 9;
const currentPage = 1;
const totalPages = Math.ceil(sortedPosts.length / postsPerPage);
const paginatedPosts = sortedPosts.slice(0, postsPerPage);
---

<BaseLayout title="Blog | KhidirID">
  <!-- Hero Section with Animation -->
  <div class="relative bg-gradient-to-br from-amber-500 to-red-600 text-white overflow-hidden">
    <div class="absolute inset-0 bg-grid-white/[0.1] bg-[size:60px_60px] animate-[grid_20s_linear_infinite]"></div>
    <div class="container mx-auto px-4 py-24">
      <h1 class="text-4xl sm:text-5xl md:text-7xl font-bold mb-6 animate-fade-in" style="--animation-delay: 200ms">
        Blog Posts
      </h1>
      <p class="text-xl md:text-2xl text-amber-100 max-w-2xl animate-fade-in" style="--animation-delay: 400ms">
        Welcome to my blog! Here you'll find my latest thoughts and updates on
        various topics. Feel free to explore and connect with me through the
        comments.
      </p>
    </div>
    <div class="absolute bottom-0 inset-x-0 h-40 bg-gradient-to-t from-gray-50 dark:from-gray-900 to-transparent"></div>
  </div>

  <main class="container mx-auto px-4 py-12">
    <!-- Search and Filter -->
    <div class="flex flex-col sm:flex-row gap-4 mb-8 animate-fade-in" style="--animation-delay: 600ms">
      <input
        type="search"
        placeholder="Search posts..."
        class="flex-1 px-4 py-2 rounded-lg border dark:border-gray-700 bg-white dark:bg-gray-800"
      />
      <div class="flex gap-2 overflow-x-auto pb-2">
        {categories.map(category => (
          <button
            class="category-btn px-4 py-2 rounded-full border-2 whitespace-nowrap hover:border-amber-500 transition-all"
            data-category={category}
          >
            {category}
          </button>
        ))}
      </div>
    </div>

    <!-- Loading State -->
    <div id="loading-state" class="hidden">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {Array(6).fill(0).map(() => (
          <div class="animate-pulse bg-gray-200 dark:bg-gray-700 rounded-lg h-64"></div>
        ))}
      </div>
    </div>

    <!-- Posts Grid with Animation -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {paginatedPosts.map((post, index) => (
        <article class="bg-white dark:bg-gray-800 rounded-lg shadow hover:shadow-lg transition-shadow">
          <a href={`/blog/${post.slug}`} class="block p-6">
            <h2 class="text-xl font-bold mb-2">{post.data.title}</h2>
            <p class="text-gray-600 dark:text-gray-400 mb-4">{post.data.description}</p>
            <div class="flex justify-between text-sm text-gray-500">
              <span>{post.data.category}</span>
              <time>{new Date(post.data.date).toLocaleDateString()}</time>
            </div>
          </a>
        </article>
      ))}
    </div>

    <!-- Pagination -->
    {totalPages > 1 && (
      <div class="flex justify-center gap-2 mt-12">
        {Array.from({ length: totalPages }).map((_, i) => (
          <button
            class:list={[
              "px-4 py-2 rounded-lg transition-colors",
              i + 1 === currentPage ? "bg-amber-500 text-white" : "bg-gray-100 dark:bg-gray-800"
            ]}
          >
            {i + 1}
          </button>
        ))}
      </div>
    )}
  </main>
</BaseLayout>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes grid {
    to { transform: translate(-50%, -50%) rotate(30deg); }
  }

  .animate-fade-in {
    opacity: 0;
    animation: fadeIn 0.5s ease-out forwards;
    animation-delay: var(--animation-delay, 0ms);
  }
</style>
