---
import BaseLayout from '../layouts/BaseLayout.astro';

const cloudSkills = [
  'Cloud Security Architecture',
  'AWS Security Best Practices',
  'Identity & Access Management (IAM)',
  'Cloud Incident Response',
  'Cloud Compliance & Governance',
  'DevSecOps',
  'Threat Detection in Cloud',
  'Container & Serverless Security'
];

const certifications = [
  { name: 'AWS Certified Security – Specialty', status: 'Planned', target: '2027' },
  { name: 'Azure Security Engineer Associate', status: 'Planned', target: '2028' },
  { name: 'Google Professional Cloud Security Engineer', status: 'Planned', target: '2029' }
];
---

<BaseLayout title="About Me | KhidirID">
  <div class="relative bg-gradient-to-br from-blue-600 to-purple-600 text-white">
    <div class="absolute inset-0 bg-grid-white/[0.1] bg-[size:60px_60px]"></div>
    <div class="container mx-auto px-4 py-24 relative z-10">
      <div class="flex flex-col md:flex-row items-center gap-8">
        <div class="w-32 h-32 rounded-full overflow-hidden ring-4 ring-white/20">
          <img 
            src="/images/profile/avatar.png"
            alt="KhidirID"
            class="w-full h-full object-cover"
          />
        </div>
        <div>
          <h1 class="text-4xl md:text-5xl font-bold mb-4">KhidirID</h1>
          <p class="text-xl text-blue-100 max-w-2xl">
            Cloud Security Enthusiast & Researcher. Passionate about securing cloud-native environments and sharing knowledge through writeups and tutorials.
          </p>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 inset-x-0 h-40 bg-gradient-to-t from-gray-50 dark:from-gray-900 to-transparent"></div>
  </div>

  <main class="container mx-auto px-4 py-12">
    <div class="max-w-3xl mx-auto space-y-12">
      <!-- Professional Summary -->
      <section>
        <h2 class="text-2xl font-bold mb-4">Professional Summary</h2>
        <div class="prose dark:prose-invert">
          <p>
            I specialize in <b>cloud security</b> with hands-on experience in AWS, Azure, and Google Cloud. My focus is on designing secure architectures, implementing best practices, and responding to cloud incidents. I enjoy sharing my journey and insights through technical writeups and open-source projects.
          </p>
        </div>
      </section>

      <!-- Cloud Security Stack -->
      <section>
        <h2 class="text-2xl font-bold mb-4">Cloud Security Stack</h2>
        <ul class="flex flex-wrap gap-3">
          {cloudSkills.map(skill => (
            <li class="inline-flex items-center px-4 py-2 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-100 rounded-full text-sm font-medium shadow-sm">
              <svg class="w-4 h-4 mr-2 text-blue-400" fill="currentColor" viewBox="0 0 20 20"><path d="M16.707 5.293a1 1 0 00-1.414 0L9 11.586 6.707 9.293a1 1 0 00-1.414 1.414l3 3a1 1 0 001.414 0l7-7a1 1 0 000-1.414z" /></svg>
              {skill}
            </li>
          ))}
        </ul>
      </section>

      <!-- Certifications & Goals -->
      <section>
        <h2 class="text-2xl font-bold mb-4">Certifications & Goals</h2>
        <div class="flex flex-wrap gap-3">
          {certifications.map(cert => (
            <span class="inline-flex items-center px-4 py-2 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-100 rounded-full text-sm font-medium shadow-sm">
              <svg class="w-4 h-4 mr-2 text-purple-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 01.894.553l3 6A1 1 0 0113 10h-2v4a1 1 0 11-2 0v-4H7a1 1 0 01-.894-1.447l3-6A1 1 0 0110 2z" /></svg>
              {cert.name} <span class="ml-2 text-xs text-gray-500">({cert.status}, Target: {cert.target})</span>
            </span>
          ))}
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
