---
import BaseLayout from '../layouts/BaseLayout.astro';

const skills = {
  offensive: [
    'Web Penetration Testing',
    'Network Security',
    'Vulnerability Assessment',
    'CTF Experience'
  ],
  defensive: [
    'Security Monitoring',
    'Incident Response',
    'Log Analysis',
    'Threat Detection'
  ],
  cloud: [
    'AWS Security',
    'Azure Security',
    'Cloud Architecture',
    'Security Controls'
  ],
  tools: [
    'Burp Suite',
    'Nmap',
    'Wireshark',
    'Metasploit'
  ]
};

const certifications = [
  { name: 'OSCP', progress: 'In Progress', target: '2024' },
  { name: 'AWS Security', progress: 'Planned', target: '2024' },
];
---

<BaseLayout title="About Me | KhidirID">
  <div class="relative bg-gradient-to-br from-amber-500 to-red-600 text-white">
    <div class="absolute inset-0 bg-grid-white/[0.1] bg-[size:60px_60px]"></div>
    <div class="container mx-auto px-4 py-24 relative z-10">
      <div class="flex flex-col md:flex-row items-center gap-8">
        <div class="w-32 h-32 rounded-full overflow-hidden ring-4 ring-white/20">
          <img 
            src="/public/images/profile/avatar.png"
            alt="KhidirID"
            class="w-full h-full object-cover"
          />
        </div>
        <div>
          <h1 class="text-4xl md:text-5xl font-bold mb-4">KhidirID</h1>
          <p class="text-xl text-amber-100 max-w-2xl">
            Security Researcher & CTF Player focused on cloud security and ethical hacking.
          </p>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 inset-x-0 h-40 bg-gradient-to-t from-gray-50 dark:from-gray-900 to-transparent"></div>
  </div>

  <main class="container mx-auto px-4 py-12">
    <div class="max-w-4xl mx-auto space-y-12">
      <!-- About Section -->
      <section>
        <h2 class="text-2xl font-bold mb-4">About Me</h2>
        <div class="prose dark:prose-invert">
          <p>
            Passionate about cybersecurity with a focus on cloud security and CTF challenges. 
            I share my knowledge and experiences through detailed writeups and tutorials.
          </p>
        </div>
      </section>

      <!-- Skills Grid -->
      <section>
        <h2 class="text-2xl font-bold mb-6">Skills & Expertise</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {Object.entries(skills).map(([category, items]) => (
            <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-lg">
              <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
                {category === 'offensive' && '🎯'}
                {category === 'defensive' && '🛡️'}
                {category === 'cloud' && '☁️'}
                {category === 'tools' && '🔧'}
                {category.charAt(0).toUpperCase() + category.slice(1)}
              </h3>
              <ul class="space-y-2">
                {items.map(item => (
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 bg-amber-500 rounded-full"></span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- Certifications -->
      <section>
        <h2 class="text-2xl font-bold mb-6">Certifications & Goals</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {certifications.map(cert => (
            <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-lg">
              <h3 class="text-lg font-semibold mb-2">{cert.name}</h3>
              <div class="flex justify-between text-sm">
                <span class="text-amber-500">{cert.progress}</span>
                <span class="text-gray-500">Target: {cert.target}</span>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
