---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import SkillCard from '../components/SkillCard.astro';

const title = "About Me | Khidir's Security Notes";

const skills = {
  cloud: ['AWS Security', 'Azure Security', 'Cloud Architecture'],
  offensive: ['Penetration Testing', 'Red Teaming', 'Web Security'],
  defensive: ['Incident Response', 'SIEM', 'Threat Hunting'],
  tools: ['Python', 'Bash', 'Go', 'Docker', 'Terraform']
};
---

<BaseLayout title={title}>
  <main class="container mx-auto px-4 py-8 max-w-4xl">
    <h1 class="text-4xl font-bold mb-8">About Me</h1>
    
    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-4">Professional Summary</h2>
      <p class="text-lg leading-relaxed">
        Cybersecurity enthusiast focused on cloud security, offensive security, and blue team operations.
        Passionate about continuous learning and sharing knowledge through practical demonstrations and write-ups.
      </p>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-4">Expertise</h2>
      <div class="grid md:grid-cols-2 gap-6">
        {Object.entries(skills).map(([category, items]) => (
          <SkillCard category={category} items={items} />
        ))}
      </div>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-4">Learning Journey</h2>
      <Timeline />
    </section>
  </main>
</BaseLayout>
