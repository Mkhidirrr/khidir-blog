---
import BaseLayout from '../layouts/BaseLayout.astro';
import Profile from '../components/Profile.astro';
import Bio from '../components/Bio.astro';
import SkillCard from '../components/SkillCard.astro';

const title = "About Me | Khidir's Security Notes";

const skills = {
  cloud: ['AWS Security', 'Azure Security', 'Cloud Architecture'],
  offensive: ['Penetration Testing', 'Red Teaming', 'Web Security'],
  defensive: ['Incident Response', 'SIEM', 'Threat Hunting'],
  tools: ['Python', 'Bash', 'Go', 'Docker', 'Terraform']
};

const journeySteps = [
  {
    year: "2023",
    title: "Deep Diving into Cloud Security",
    description: "Mastering AWS and Azure security architectures, conducting cloud penetration testing, and implementing secure CI/CD pipelines. Currently focused on cloud-native security and containerization.",
    location: "Remote & Virtual Labs",
    achievements: [
      "Completed multiple AWS and Azure security certifications",
      "Built personal cloud security testing lab",
      "Contributing to cloud security open-source projects"
    ]
  },
  {
    year: "2022",
    title: "Beginning the Cybersecurity Journey",
    description: "Started my journey in cybersecurity through self-learning and online platforms. Discovered my passion for ethical hacking and defensive security.",
    location: "Jakarta, Indonesia",
    achievements: [
      "Completed fundamental cybersecurity courses",
      "Started participating in CTF competitions",
      "Built home lab for security testing"
    ]
  }
];
---

<BaseLayout title="About Me | KhidirID">
  <main class="container mx-auto px-4 py-8 max-w-4xl">
    <div class="grid md:grid-cols-[300px_1fr] gap-8">
      <aside>
        <Profile />
      </aside>
      <div>
        <Bio />
        <div class="space-y-12">
          <!-- Hero Section -->
          <section class="text-center">
            <h1 class="text-4xl font-bold mb-4">Hi, I'm Khidir 👋</h1>
            <p class="text-xl text-gray-600 dark:text-gray-400">
              A cybersecurity enthusiast from Jakarta, Indonesia, passionate about securing the cloud and breaking things ethically.
            </p>
          </section>

          <!-- Journey Map -->
          <section class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg">
            <h2 class="text-2xl font-semibold mb-6">My Security Journey</h2>
            <div class="space-y-8">
              {journeySteps.map((step, index) => (
                <div class="flex gap-4">
                  <div class="flex flex-col items-center">
                    <div class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center text-white font-bold">
                      {journeySteps.length - index}
                    </div>
                    {index !== journeySteps.length - 1 && (
                      <div class="w-0.5 h-full bg-blue-200 dark:bg-blue-800"></div>
                    )}
                  </div>
                  <div class="flex-1">
                    <div class="flex justify-between items-start mb-2">
                      <h3 class="text-xl font-medium">{step.title}</h3>
                      <span class="text-sm bg-blue-100 dark:bg-blue-900 px-2 py-1 rounded">
                        {step.year}
                      </span>
                    </div>
                    <p class="text-gray-600 dark:text-gray-400 mb-2">{step.description}</p>
                    <div class="text-sm text-gray-500 dark:text-gray-400 mb-2">
                      📍 {step.location}
                    </div>
                    <ul class="list-disc list-inside text-gray-600 dark:text-gray-400 space-y-1">
                      {step.achievements.map(achievement => (
                        <li>{achievement}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <!-- Expertise Section -->
          <section>
            <h2 class="text-2xl font-semibold mb-6">Areas of Focus</h2>
            <div class="grid md:grid-cols-2 gap-6">
              {Object.entries(skills).map(([category, items]) => (
                <SkillCard category={category} items={items} />
              ))}
            </div>
          </section>

          <!-- Current Projects -->
          <section class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg">
            <h2 class="text-2xl font-semibold mb-4">Current Projects</h2>
            <div class="space-y-4">
              <div>
                <h3 class="font-medium">Personal Cloud Security Lab</h3>
                <p class="text-gray-600 dark:text-gray-400">
                  Building and documenting a comprehensive cloud security testing environment using AWS and Azure.
                </p>
              </div>
              <div>
                <h3 class="font-medium">CTF Writeups</h3>
                <p class="text-gray-600 dark:text-gray-400">
                  Documenting my journey through various CTF platforms to help others learn and grow.
                </p>
              </div>
            </div>
          </section>

          <!-- Contact Section -->
          <section class="text-center">
            <h2 class="text-2xl font-semibold mb-4">Let's Connect</h2>
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              Always interested in collaborating on security projects and sharing knowledge.
            </p>
            <div class="flex justify-center gap-4">
              <a href="https://github.com/Mkhidirrr" class="text-blue-500 hover:text-blue-600">
                GitHub
              </a>
              <!-- Add more social links as needed -->
            </div>
          </section>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
