---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageTransition from '../components/PageTransition.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/animations.css';

const site = Astro.site || 'https://khidir-blog.vercel.app';

// Props (you can override `image` per-page)
const {
  title,
  description = "Personal blog about Cybersecurity, CTF Writeups, and Cloud Security Labs",
  image = '/images/profile/avatar.png'
} = Astro.props;

const currentPath = Astro.url && Astro.url.pathname ? Astro.url.pathname : '/';
const pageUrl = site + currentPath;
const ogImage = image.startsWith('http') ? image : site + image;
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <!-- Accessibility-friendly viewport -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <!-- Basic SEO -->
    <meta name="description" content={description} />
    <meta name="author" content="KhidirID" />
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph (Facebook, LinkedIn, Discord, Telegram, WhatsApp, etc.) -->
    <meta property="og:site_name" content="KhidirID" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <!-- Best-effort dimensions — replace with real dims if you have them -->
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />

    <!-- Twitter Card (fallback + enhancements) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@KhidirID" />
    <meta name="twitter:creator" content="@KhidirID" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Profile avatar — KhidirID" />

    <!-- Structured Data -->
    <script type="application/ld+json">
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "KhidirID",
      "url": site,
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${site}/search?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    })}
    </script>

    <!-- Fonts: preconnect + stylesheet (no bogus SRI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />

    <!-- PWA, theme color -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#3B82F6" />

    <!-- Favicon / touch icon (relative from /public) -->
    <link rel="icon" href="/images/profile/avatar.png" />
    <link rel="apple-touch-icon" href="/images/profile/avatar.png" />

    <style is:global>
      :root {
        --primary: #3b82f6;
        --primary-dark: #2563eb;
        --accent: #8b5cf6;
      }

      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none;
        mix-blend-mode: normal;
      }

      .dark::view-transition-old(root),
      .dark::view-transition-new(root) {
        mix-blend-mode: normal;
      }

      .container {
        padding-left: max(1rem, env(safe-area-inset-left));
        padding-right: max(1rem, env(safe-area-inset-right));
      }

      @media (max-width: 640px) {
        html { font-size: 14px; }
      }

      @media (min-width: 641px) and (max-width: 1024px) {
        .container { padding-left: 2rem; padding-right: 2rem; }
      }
    </style>

    <!-- Small, robust theme script: safe for privacy modes / scrapers -->
    <script is:inline>
    (function () {
      try {
        function setTheme(theme) {
          document.documentElement.classList.toggle('dark', theme === 'dark');
          try { localStorage.setItem('theme', theme); } catch (e) {}
          document.documentElement.style.colorScheme = theme;
        }

        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) { saved = null; }
        var system = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
        setTheme(saved || system);

        if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').addEventListener) {
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
            try {
              if (!localStorage.getItem('theme')) {
                setTheme(e.matches ? 'dark' : 'light');
              }
            } catch (err) {}
          });
        }
      } catch (err) {
        /* fail silently — important for some crawlers / strict browsers */
      }
    })();
    </script>

    <style is:global>
      :root { color-scheme: light dark; }

      html.transitioning * { transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease !important; }
      html { transition: background-color 0.3s ease, color 0.3s ease; }
      html.dark * { transition-duration: 0.3s; }
    </style>
  </head>

  <body class="bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800 min-h-screen font-sans">
    <div class="relative">
      <!-- Animated background elements -->
      <div class="fixed inset-0 -z-10">
        <div class="absolute top-0 -left-4 w-72 h-72 bg-purple-300 dark:bg-purple-900 rounded-full mix-blend-multiply filter blur-xl animate-blob"></div>
        <div class="absolute top-0 -right-4 w-72 h-72 bg-yellow-300 dark:bg-yellow-900 rounded-full mix-blend-multiply filter blur-xl animate-blob animation-delay-2000"></div>
        <div class="absolute -bottom-8 left-20 w-72 h-72 bg-pink-300 dark:bg-pink-900 rounded-full mix-blend-multiply filter blur-xl animate-blob animation-delay-4000"></div>
      </div>

      <Header currentPath={currentPath} />
      <main class="relative">
        <PageTransition />
        <slot />
      </main>
      <Footer />
    </div>

    <!-- Analytics component (consider privacy/consent handling inside it) -->
    <Analytics />

    <noscript>
      <!-- Small fallback / note for users with JS disabled -->
      <div style="position:fixed;bottom:0;left:0;right:0;background:#111;color:#fff;padding:6px;text-align:center;font-size:13px;">
        Some site features require JavaScript. Please enable JS for the best experience.
      </div>
    </noscript>
  </body>
</html>
