---
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import BackToTop from '../components/BackToTop.astro';
import ImageZoom from '../components/ImageZoom.astro';
import FloatingTOC from '../components/FloatingTOC.astro';
import { getReadingTime } from '../utils/readingTime';
import { getCollection } from 'astro:content';

const { frontmatter, content = '' } = Astro.props;
const readingTime = getReadingTime(content);

type PostType = { data: { title: string }; slug: string };

// Get next and previous posts
let allPosts: PostType[] = [];
let currentIndex = -1;
let prevPost: PostType | null = null;
let nextPost: PostType | null = null;
if (frontmatter.collection) {
  allPosts = (await getCollection(frontmatter.collection)) as PostType[];
  currentIndex = allPosts.findIndex(post => post.data.title === frontmatter.title);
  prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
  nextPost = currentIndex >= 0 && currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
}

// Parse headings for TOC (simple example, adjust as needed)
type HeadingType = { level: number; text: string };
const headings: HeadingType[] = content.match(/^(#{1,6})\s+(.*)$/gm)?.map((line: string) => {
  const match = /^(#{1,6})\s+(.*)$/.exec(line);
  return match ? { level: match[1].length, text: match[2] } : null;
})?.filter(Boolean) as HeadingType[] ?? [];
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <article class="container mx-auto px-4 py-8">
    <header class="mb-8">
      <h1 class="text-4xl font-bold mb-4">{frontmatter.title}</h1>
      <div class="flex items-center gap-4 text-gray-600 dark:text-gray-400 mb-4">
        <time datetime={frontmatter.date}>
          {new Date(frontmatter.date).toLocaleDateString()}
        </time>
        {frontmatter.platform && (
          <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded">
            {frontmatter.platform}
          </span>
        )}
        {frontmatter.difficulty && (
          <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded">
            {frontmatter.difficulty}
          </span>
        )}
        <span>•</span>
        <span>{readingTime} min read</span>
      </div>
      <TagList tags={frontmatter.tags} />
    </header>
    
    <!-- Main content with TOC sidebar -->
    <div class="lg:grid lg:grid-cols-[250px_1fr] gap-8">
      <FloatingTOC headings={headings} />
      <div class="prose dark:prose-invert max-w-none">
        <slot />
      </div>
    </div>

    <!-- Navigation -->
    {currentIndex === -1 ? (
      <div class="mt-12 text-center text-red-500">Post not found.</div>
    ) : (
      <nav class="mt-12 flex justify-between border-t dark:border-gray-800 pt-8">
        {prevPost && (
          <a href={`/${frontmatter.collection}/${prevPost.slug}`} class="group">
            <span class="block text-sm text-gray-600 dark:text-gray-400">Previous</span>
            <span class="text-lg font-medium group-hover:text-blue-500">{prevPost.data.title}</span>
          </a>
        )}
        {nextPost && (
          <a href={`/${frontmatter.collection}/${nextPost.slug}`} class="group text-right">
            <span class="block text-sm text-gray-600 dark:text-gray-400">Next</span>
            <span class="text-lg font-medium group-hover:text-blue-500">{nextPost.data.title}</span>
          </a>
        )}
      </nav>
    )}

    <!-- Related Posts -->
    <RelatedPosts 
      currentPost={frontmatter} 
      collection={frontmatter.collection}
      tags={frontmatter.tags}
    />
  </article>

  <BackToTop />
  <ImageZoom />
</BaseLayout>
