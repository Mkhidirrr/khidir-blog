---
import { getCollection } from 'astro:content';

const { currentPost, maxPosts = 3 } = Astro.props;
const allPosts = await getCollection(currentPost.collection);

const relatedPosts = allPosts
  .filter(post => 
    post.slug !== currentPost.slug && 
    post.data.tags.some(tag => currentPost.tags.includes(tag))
  )
  .slice(0, maxPosts);
---

<section class="mt-16 pt-8 border-t dark:border-gray-800">
  <h2 class="text-2xl font-bold mb-6">Related Posts</h2>
  <div class="grid md:grid-cols-3 gap-6">
    {relatedPosts.map(post => (
      <a href={`/${post.collection}/${post.slug}`} class="group">
        <article class="p-4 rounded-lg border dark:border-gray-800 hover:border-blue-500 transition-colors">
          <h3 class="font-semibold group-hover:text-blue-500">{post.data.title}</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">{post.data.description}</p>
        </article>
      </a>
    ))}
  </div>
</section>
