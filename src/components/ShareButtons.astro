---
const { title } = Astro.props;
const currentUrl = Astro.url;

const shareLinks = [
  {
    name: 'Twitter',
    url: `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${currentUrl}`,
    icon: 'twitter'
  },
  {
    name: 'LinkedIn',
    url: `https://www.linkedin.com/sharing/share-offsite/?url=${currentUrl}`,
    icon: 'linkedin'
  }
];
---

<div class="bg-gray-50 dark:bg-gray-800 p-4 rounded-lg">
  <h3 class="text-sm font-medium mb-3">Share this post</h3>
  <div class="flex gap-2">
    {shareLinks.map(link => (
      <a
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 text-gray-600 hover:text-blue-500 dark:text-gray-400 dark:hover:text-blue-400"
      >
        <span class="sr-only">Share on {link.name}</span>
        <i class={`fab fa-${link.icon} text-lg`}></i>
      </a>
    ))}
  </div>
</div>
