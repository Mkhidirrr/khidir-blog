---
const platforms = ['HTB', 'THM', 'PicoCTF', 'OverTheWire', 'RootMe'];
const difficulties = ['Easy', 'Medium', 'Hard'];
---

<div class="mb-8 p-6 bg-white dark:bg-gray-800 rounded-lg shadow">
  <div class="flex flex-wrap gap-4">
    <div class="flex-1">
      <input 
        type="search" 
        id="search-input"
        placeholder="Search writeups..."
        class="w-full px-4 py-2 rounded-lg border dark:border-gray-700 bg-white dark:bg-gray-900"
      />
    </div>
    
    <select id="platform-filter" class="px-4 py-2 rounded-lg border dark:border-gray-700 bg-white dark:bg-gray-900">
      <option value="">All Platforms</option>
      {platforms.map(p => <option value={p}>{p}</option>)}
    </select>
    
    <select id="difficulty-filter" class="px-4 py-2 rounded-lg border dark:border-gray-700 bg-white dark:bg-gray-900">
      <option value="">All Difficulties</option>
      {difficulties.map(d => <option value={d}>{d}</option>)}
    </select>
    
    <label class="flex items-center gap-2">
      <input type="checkbox" id="solved-filter" class="rounded" />
      <span>Solved only</span>
    </label>
  </div>
</div>

<script>
  const searchInput = document.getElementById('search-input');
  const platformFilter = document.getElementById('platform-filter');
  const difficultyFilter = document.getElementById('difficulty-filter');
  const solvedFilter = document.getElementById('solved-filter');

  function filterResults() {
    const query = searchInput.value.toLowerCase();
    const platform = platformFilter.value;
    const difficulty = difficultyFilter.value;
    const solvedOnly = solvedFilter.checked;
    
    // Filter logic implementation
    // ...
  }

  [searchInput, platformFilter, difficultyFilter, solvedFilter].forEach(el => {
    el?.addEventListener('change', filterResults);
  });
  
  searchInput?.addEventListener('input', filterResults);
</script>
