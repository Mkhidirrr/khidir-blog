---
---

<div class="relative max-w-lg mx-auto">
  <input
    type="search"
    id="search"
    class="w-full px-4 py-2 rounded-lg border dark:border-gray-700 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-blue-500"
    placeholder="Search posts..."
  />
  <div id="search-results" class="absolute w-full mt-2 bg-white dark:bg-gray-800 rounded-lg shadow-lg border dark:border-gray-700 hidden">
  </div>
</div>

<script>
  const search = document.getElementById('search');
  const results = document.getElementById('search-results');
  
  search?.addEventListener('input', async (e) => {
    const query = (e.target as HTMLInputElement).value;
    if (query.length < 2) {
      results?.classList.add('hidden');
      return;
    }
    
    try {
      const response = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
      const data = await response.json();
      
      results?.classList.remove('hidden');
      results!.innerHTML = data.results
        .map((result: any) => `
          <a href="${result.url}" class="block p-4 hover:bg-gray-100 dark:hover:bg-gray-700">
            <div class="font-medium">${result.title}</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">${result.type} • ${result.platform}</div>
          </a>
        `)
        .join('');
    } catch (err) {
      console.error('Search failed:', err);
    }
  });
</script>
