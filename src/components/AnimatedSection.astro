---
interface Props {
  delay?: number;
  animation?: 'fade-in' | 'fade-in-up' | 'slide-in';
  class?: string;
}

const { 
  delay = 0,
  animation = 'fade-in',
  class: className = ''
} = Astro.props;
---

<div 
  class:list={[
    'opacity-0',
    `animate-${animation}`,
    className
  ]}
  style={`animation-delay: ${delay}ms`}
>
  <slot />
</div>
