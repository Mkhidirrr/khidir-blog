---
interface Props {
  post: any;
}

const { post } = Astro.props;
---

<article class="bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300">
  <a href={`/blog/${post.slug}`} class="block p-6">
    <div class="flex items-center gap-3 mb-4">
      <span class="text-sm px-3 py-1 bg-amber-100 dark:bg-amber-900/30 text-amber-800 dark:text-amber-200 rounded-full">
        {post.data.category}
      </span>
      <time class="text-sm text-gray-500">
        {new Date(post.data.date).toLocaleDateString()}
      </time>
    </div>
    <h2 class="text-xl font-bold mb-3 group-hover:text-amber-500 transition-colors">
      {post.data.title}
    </h2>
    <p class="text-gray-600 dark:text-gray-400 line-clamp-3">
      {post.data.description}
    </p>
    <div class="flex items-center gap-3 mt-4 text-sm text-gray-500">
      <span>{post.data.readingTime} min read</span>
      <span>•</span>
      <span>{post.data.tags.join(', ')}</span>
    </div>
  </a>
</article>
