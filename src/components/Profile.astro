---
const socialLinks = [
  { name: 'GitHub', url: 'https://github.com/Mkhidirrr', icon: 'github' },
  { name: 'Twitter', url: 'https://twitter.com/KhidirID', icon: 'twitter' },
  { name: 'LinkedIn', url: '#', icon: 'linkedin' }
];
---

<div class="flex flex-col items-center text-center p-8 bg-white dark:bg-gray-800 rounded-lg shadow-lg">
  <img 
    src="/images/profile/avatar.webp" 
    alt="KhidirID"
    class="w-24 h-24 rounded-full ring-4 ring-blue-500 mb-4"
  />
  <h2 class="text-2xl font-bold mb-2">KhidirID</h2>
  <p class="text-gray-600 dark:text-gray-400 mb-4">
    Security Researcher & CTF Player
  </p>
  <div class="flex gap-4">
    {socialLinks.map(link => (
      <a 
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-600 hover:text-blue-500 dark:text-gray-400 dark:hover:text-blue-400"
      >
        <i class={`fab fa-${link.icon} text-2xl`}></i>
        <span class="sr-only">{link.name}</span>
      </a>
    ))}
  </div>
</div>
