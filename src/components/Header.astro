---
const { currentPath } = Astro.props;
const navItems = [
  { title: 'CTF', path: '/ctf' },
  { title: 'Labs', path: '/labs' },
  { title: 'Blog', path: '/blog' },
  { title: 'About', path: '/about' }
];
---

<header class="sticky top-0 z-50 bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm border-b border-gray-200 dark:border-gray-800">
  <nav class="container mx-auto px-4 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 group">
      <div class="w-10 h-10 rounded-full overflow-hidden ring-2 ring-blue-500/50 group-hover:ring-blue-500 transition-all">
        <img 
          src="/images/profile/avatar.png" 
          alt="KhidirID"
          width="40"
          height="40"
          loading="eager"
          decoding="async"
          class="w-full h-full object-cover transform hover:scale-105 transition-transform"
        />
      </div>
      <span class="text-xl font-bold bg-gradient-to-r from-blue-500 to-purple-600 bg-clip-text text-transparent">
        KhidirID
      </span>
    </a>
    
    <div class="flex items-center gap-6">
      {navItems.map(item => (
        <div class="relative group">
          <a 
            href={item.path} 
            class:list={[
              "px-2 py-1 rounded-md hover:bg-blue-50 dark:hover:bg-blue-900/20 hover:text-blue-500 transition-colors",
              { "text-blue-500 bg-blue-50 dark:bg-blue-900/20": currentPath?.startsWith(item.path) }
            ]}
          >
            {item.title}
          </a>
        </div>
      ))}
      
      <button 
        id="theme-toggle" 
        class="p-2 rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/20 hover:text-blue-500 transition-colors"
      >
        🌗
      </button>
    </div>
  </nav>
</header>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  
  themeToggle?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', 
      document.documentElement.classList.contains('dark') ? 'dark' : 'light'
    );
  });

  // Check initial theme
  if (localStorage.getItem('theme') === 'dark' || 
      (!localStorage.getItem('theme') && 
       window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    document.documentElement.classList.add('dark');
  }
</script>

<style>
  img {
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
  }
</style>
