---
interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className = '' } = Astro.props;
---

<div class={`flex gap-2 flex-wrap ${className}`}>
  {tags.map(tag => (
    <a 
      href={`/tags/${tag}`}
      class="px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full text-sm hover:opacity-80"
    >
      #{tag}
    </a>
  ))}
</div>
