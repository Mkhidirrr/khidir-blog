---
const milestones = [
  {
    date: "2023",
    title: "Cloud Security Focus",
    description: "Deep diving into AWS & Azure security"
  },
  {
    date: "2022",
    title: "Offensive Security",
    description: "Learning penetration testing & red teaming"
  }
  // Tambahkan milestone lain sesuai kebutuhan
];
---

<div class="space-y-8">
  {milestones.map(milestone => (
    <div class="flex gap-4">
      <div class="flex flex-col items-center">
        <div class="w-4 h-4 bg-blue-500 rounded-full"></div>
        <div class="w-0.5 h-full bg-gray-200 dark:bg-gray-700"></div>
      </div>
      <div>
        <time class="text-sm text-gray-500">{milestone.date}</time>
        <h3 class="font-medium">{milestone.title}</h3>
        <p class="text-gray-600 dark:text-gray-400">{milestone.description}</p>
      </div>
    </div>
  ))}
</div>
