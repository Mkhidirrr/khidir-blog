---
interface Props {
  title: string;
  subtitle: string;
  gradient?: string;
}

const { 
  title, 
  subtitle,
  gradient = "from-blue-600 to-purple-600" 
} = Astro.props;
---

<div class={`relative overflow-hidden bg-gradient-to-br ${gradient} text-white`}>
  <div class="absolute inset-0 bg-grid-white/[0.1] bg-[size:60px_60px]"></div>
  <div class="container mx-auto px-4 py-32">
    <h1 
      class="text-5xl md:text-7xl font-bold mb-6 font-display animate-fade-in"
      style="--animation-delay: 200ms"
    >
      {title}
    </h1>
    <p 
      class="text-xl md:text-2xl text-gray-100 max-w-2xl animate-fade-in"
      style="--animation-delay: 400ms"
    >
      {subtitle}
    </p>
  </div>
  <div class="absolute bottom-0 inset-x-0 h-40 bg-gradient-to-t from-white dark:from-gray-900 to-transparent"></div>
</div>
